# Skill2Pocket Environment Configuration

# Database Setup (Supports PostgreSQL / Supabase & SQLite fallback out of the box)
DATABASE_URL=sqlite+aiosqlite:///./skill2pocket.db
# For PostgreSQL / Supabase PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@db.xxxx.supabase.co:5432/postgres

# Supabase Auth Configuration (Optional)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend Security
SECRET_KEY=skill2pocket_super_secret_jwt_key_2026_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Configuration (LLM Abstraction - Supports Ollama, OpenAI API, and Fallback structured NLP)
AI_PROVIDER=fallback # ollama | openai | fallback
AI_BASE_URL=http://localhost:11434 # or https://api.openai.com
AI_API_KEY=
AI_MODEL=llama3 # or gpt-3.5-turbo

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
